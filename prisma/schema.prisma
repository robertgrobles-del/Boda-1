generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; el resto para el runtime de Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" de Supabase (puerto 6543, pgbouncer) — la usa la app en runtime.
  url       = env("DATABASE_URL")
  // Conexión directa de Supabase (puerto 5432) — la usan `prisma migrate` / `prisma db push`.
  directUrl = env("DIRECT_URL")
}

model RSVP {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String? // Teléfono del invitado
  attending   Boolean
  guestsCount Int
  dietary     String?
  message     String?
  cedulas     String // JSON array de cédulas
  guestNames  String? // JSON array de nombres oficiales (API de cédula), uno por invitado
  createdAt   DateTime @default(now())
}

// Asignación de un invitado (persona individual) a una mesa de la recepción.
// personKey = "<rsvpId>:<índice del invitado dentro de esa confirmación>"
model SeatAssignment {
  id          Int      @id @default(autoincrement())
  personKey   String   @unique
  tableNumber Int
  seatIndex   Int? // asiento concreto dentro de la mesa (0 = arriba, sentido horario); null = sin asiento fijo
  updatedAt   DateTime @updatedAt
}

// Metadatos de una mesa de la recepción (su etiqueta / grupo).
model TableMeta {
  id          Int     @id @default(autoincrement())
  tableNumber Int     @unique
  label       String  @default("")
  locked      Boolean @default(false) // mesa fija: auto-asignar la ignora
  capacity    Int? // capacidad propia de esta mesa (si null, usa el tamaño global)
  x           Float? // posición en el plano del salón (fracción 0..1)
  y           Float?
}

// Ajustes del sitio y del panel (una sola fila, id = 1). `data` = JSON con todo.
model Setting {
  id   Int  @id @default(1)
  data Json @default("{}")
}

model GuestMessage {
  id        Int      @id @default(autoincrement())
  name      String
  message   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AllowedGuest {
  id        Int       @id @default(autoincrement())
  phone     String    @unique
  pin       String
  name      String? // Nombre del invitado (para el saludo personalizado y el enlace ?invitado=)
  tag       String? // Etiqueta / grupo (p.ej. "Familia novia") — para auto-asignar mesa al confirmar
  ceremonyOnly Boolean @default(false) // true = solo invitación a la ceremonia (no a la recepción)
  receptionOnly Boolean @default(false) // true = solo invitación a la recepción (no a la ceremonia)
  maxGuests Int       @default(2) // Cupos totales asignados a este número
  usedCount Int       @default(0) // Invitados ya registrados (acumulado en varios RSVP)
  used      Boolean   @default(false) // true cuando usedCount >= maxGuests (o declinó)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
