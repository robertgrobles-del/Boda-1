# Copia este archivo a  .env  y rellena los valores.
#   cp .env.example .env
#
# En producción NO se usa este archivo: las variables se configuran en
# Vercel → Project → Settings → Environment Variables.

# ── Base de datos (Supabase) ───────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
#
#  DATABASE_URL = "Transaction pooler" (puerto 6543) — la usa la app en runtime.
#                 Añade  ?pgbouncer=true&connection_limit=1
#  DIRECT_URL   = "Direct connection / Session pooler" (puerto 5432) —
#                 la usan  `prisma db push`  y  `prisma migrate`.
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Panel /admin ───────────────────────────────────────────────────────────
ADMIN_API_KEY="pon-una-clave-larga-y-secreta"

# ── Correo de confirmación (opcional) ──────────────────────────────────────
EMAIL_USER=""
EMAIL_PASS=""

# ── Subida de fotos a Google Drive (opcional) ──────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_FOLDER_ID=""

# ── Solo local ────────────────────────────────────────────────────────────
PORT=3001
# Fuerza la URL del backend en el frontend (normalmente NO hace falta).
# VITE_API_URL=""
